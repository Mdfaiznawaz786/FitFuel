# Backend only. Copy to .env for local development; use secret environment
# variables on your hosting provider for deployment.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-server-only-supabase-key
GEMINI_API_KEY=replace-with-your-gemini-key
JWT_SECRET=replace-with-a-long-random-secret
# Optional: override the default Gemini model.
# GEMINI_MODEL=gemini-3.8-flash
